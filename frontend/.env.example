# ─── Backend ────────────────────────────────────────────────────────────────
# URL del backend (usada por el servidor Next.js para los rewrites y NextAuth)
BACKEND_URL=https://tu-backend.com

# URL del backend expuesta al navegador (usada por socket.io)
NEXT_PUBLIC_BACKEND_URL=https://tu-backend.com

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL canónica de tu app en Vercel (ej. https://arise-coach.vercel.app)
# En Vercel se puede dejar vacío si usas AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://arise-coach.vercel.app
AUTH_TRUST_HOST=true

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Configura en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Panel de administración de planes ───────────────────────────────────────
# Muestra el tab "Planes" (CRUD de planes) en el panel de admin de /cuenta.
# Valores: 'true' para mostrarlo, cualquier otro valor (o ausencia) lo oculta.
NEXT_PUBLIC_ADMIN_PLANS_PANEL=false

# ─── Stripe (Price IDs) ──────────────────────────────────────────────────────
# Usa los IDs de TEST para staging y los de LIVE para producción
NEXT_PUBLIC_STRIPE_PRICE_INTRO=
NEXT_PUBLIC_STRIPE_PRICE_SILVER=
NEXT_PUBLIC_STRIPE_PRICE_GOLD=
NEXT_PUBLIC_STRIPE_PRICE_ESMERALD=
NEXT_PUBLIC_STRIPE_PRICE_DIAMOND=
NEXT_PUBLIC_STRIPE_PRICE_NOLIFE=
NEXT_PUBLIC_STRIPE_PRICE_CHALLENGER=
